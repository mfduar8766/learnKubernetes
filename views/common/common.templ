package common

templ Header(route, styleSheetPath string) {
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		// <script src="https://unpkg.com"></script>
		<script src="https://unpkg.com/htmx.org@1.9.10"></script>
		<link rel="stylesheet" href={ styleSheetPath }/>
		if route == "/" {
			<title>App</title>
		}
	</head>
}

templ Button(buttonType, text string) {
	<button
		class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline mb-1"
		type={ buttonType }
	>
		{ text }
	</button>
}

templ Form() {
	<div class="container w-full h-full">
		<form
			class="bg-white shadow-md rounded px-8 pt-6 pb-8 mb-4"
			hx-post="{{api_url}}login"
			hx-target="#app"
			id="log-in-form"
			hx-swap="outerHTML"
		>
			<div class="mb-4">
				<label class="block text-gray-700 text-sm font-bold mb-2" for="username">
					Email
				</label>
				<input
					class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline"
					id="email"
					type="text"
					placeholder="Email"
					name="email"
				/>
			</div>
			<div class="mb-6">
				<label class="block text-gray-700 text-sm font-bold mb-2" for="password">
					Password
				</label>
				<input
					class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 mb-3 leading-tight focus:outline-none focus:shadow-outline"
					id="password"
					type="password"
					placeholder="***"
					name="password"
				/>
				<div id="htmx-alert" class="alert alert-warning sticky-top"></div>
				<p
					hx-swap="innerHTML"
					hx-target-5*="#serious-errors"
					hx-target-404="#not-found"
					hx-target-400="#error-message"
					class="text-red-500 text-xs italic"
					id="error-message"
				></p>
				<!-- <p class="text-red-500 text-xs italic">Please choose a password.</p> -->
			</div>
			<div class="flex flex-col items-center">
				<button
					class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline mb-1"
					type="submit"
				>
					Sign In
				</button>
				<a
					class="inline-block align-baseline font-bold text-sm text-blue-500 hover:text-blue-800"
					href="#"
				>
					Create Account
				</a>
				<a
					class="inline-block align-baseline font-bold text-sm text-blue-500 hover:text-blue-800 mt-1"
					href="#"
				>
					Forgot Password?
				</a>
			</div>
		</form>
		<!-- <p class="text-center text-gray-500 text-xs">
    &copy;2020 Acme Corp. All rights reserved.
  </p> -->
	</div>
}
