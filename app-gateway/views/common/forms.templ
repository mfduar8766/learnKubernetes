package common

import "github.com/mfduar8766/learnKubernetes/lib/events"
import "github.com/mfduar8766/learnKubernetes/lib/utils"
import "github.com/mfduar8766/learnKubernetes/lib/types"

templ LogInForm(apiURL string) {
	{{
		headersMap := map[string]events.LogInEventType{
			types.API_NAME: events.LOGIN,
		}
		headers, _ := utils.JsonMarshall(headersMap)
	}}
	<div class="container w-full h-full">
		<form
			class="bg-white shadow-md rounded px-8 pt-6 pb-8 mb-4"
			hx-post={ apiURL }
			hx-target="#app"
			id="log-in-form"
			hx-swap="outerHTML"
			hx-headers={ string(headers) }
		>
			<div class="mb-4">
				@Label("email", "Email", "")
				@Input("email", "text", "Enter Email", "email", "shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline")
			</div>
			<div class="mb-6">
				@Label("password", "Password", "")
				@Input("password", "password", "Enter Password", "password", "shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 mb-3 leading-tight focus:outline-none focus:shadow-outline")
				<div id="htmx-alert" class="alert alert-warning sticky-top"></div>
				<p
					hx-swap="innerHTML"
					hx-target-5*="#serious-errors"
					hx-target-404="#not-found"
					hx-target-400="#error-message"
					class="text-red-500 text-xs italic"
					id="error-message"
				></p>
				<!-- <p class="text-red-500 text-xs italic">Please choose a password.</p> -->
			</div>
			<div class="flex flex-col items-center">
				@Button("submit", "Sign In", "")
				<a
					class="inline-block align-baseline font-bold text-sm text-blue-500 hover:text-blue-800"
					href="#"
				>
					Create Account
				</a>
				<a
					class="inline-block align-baseline font-bold text-sm text-blue-500 hover:text-blue-800 mt-1"
					href="#"
				>
					Forgot Password?
				</a>
			</div>
		</form>
	</div>
}
